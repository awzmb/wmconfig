# hyprland flavor packages — layered on top of the shared base image.
#
# GNOME (GDM greeter) + a from-git Hyprland session. The compositor, hyprlock,
# hypridle, xdg-desktop-portal-hyprland, hyprland-guiutils and the hy3 plugin are
# built from source in the hypr-builder stage (scripts/build-hyprland.sh); this
# list is the Fedora packages layered around them. DE-agnostic bits come from the
# base image.
#
# Lines beginning with '#' and blank lines are ignored. Installed with
# `dnf install --skip-unavailable --skip-broken`.

# GNOME (GDM login/greeter; Sway is the default session — see scripts/configure.sh.
# gnome-shell is required by the GDM greeter even though Sway is the main WM)
gdm
evolution-data-server
gnome-backgrounds
gnome-console
gnome-control-center
gnome-disk-utility
gnome-initial-setup
gnome-menus
gnome-shell
gnome-session # session launcher GDM execs; Recommends-vulnerable under weak-deps-off
gnome-settings-daemon # display/power/media-keys glue; a missing g-s-d can black-screen the session
gnome-software
gnome-system-monitor
gnome-tweaks
gnome-keyring
# Fedora splits the PAM module into its own subpackage; without it logins log
# "gkr-pam: ... missing" and the login keyring is never unlocked (this also broke
# starting the Sway session via GDM). Required for GNOME/Silverblue-style keyring
# auto-unlock at login.
gnome-keyring-pam
mutter
nautilus
gvfs
gvfs-afc
gvfs-fuse
gvfs-goa
gvfs-gphoto2
gvfs-mtp
gvfs-nfs
gvfs-smb
xdg-desktop-portal-gtk # FileChooser/Settings backend (hyprland-portals.conf: default=hyprland;gtk)
xdg-desktop-portal-gnome

# wlroots session helpers (launcher, notifications, clipboard, night light)
fuzzel
cliphist
gammastep
gammastep-indicator
rofi-wayland
dunst
wl-mirror
seatd # seat management for the wlroots sessions

# Sway packages
kanshi
waybar
wlr-randr
grim
slurp
blueman

# Hyprland session tools referenced by .config/hypr/* (the compositor itself,
# hyprlock, hypridle, xdg-desktop-portal-hyprland and hy3 are built from git in
# the hypr-builder stage — see scripts/build-hyprland.sh — so they are NOT listed
# here). These are the extra Fedora tools the hypr configs invoke.
Thunar        # $fileManager in hyprland.conf
tumbler       # Thunar thumbnails
polkit-gnome  # polkit-gnome-authentication-agent-1 (exec-once)
swaylock      # hypridle on-timeout locker
libnotify     # notify-send, used by grimshot

# Hyprland runtime shared libraries (the git-built binaries link these; the
# -devel headers live only in the throwaway builder stage). Most are already
# pulled by the desktop packages above, listed explicitly so a slimmer future
# package set can't silently drop them.
mesa-libEGL
mesa-libGL
mesa-libgbm
libdrm
libinput
libseat
libxkbcommon
pixman
cairo
pango
libdisplay-info
libliftoff
xcb-util-errors # libxcb-errors.so — Hyprland's Xwayland/XWM error reporting
re2
muParser
tomlplusplus
pugixml
librsvg2
libzip
libjpeg-turbo
libwebp
libspng
file-libs
sdbus-cpp
hwdata
pam
pipewire
iniparser   # hyprtoolkit (hyprland-dialog) runtime
abseil-cpp  # hyprtoolkit (hyprland-dialog) runtime
xorg-x11-server-Xwayland

# Qt6 runtime for xdph hyprland-share-picker
qt6-qtbase-gui
qt6-qtwayland
