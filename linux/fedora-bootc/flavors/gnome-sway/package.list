# gnome-sway flavor packages — layered on top of the shared base image.
#
# The full daily-driver desktop: GNOME (GDM greeter + GNOME session) with Sway as
# the default session and Hyprland also available. DE-agnostic bits (terminals,
# fonts, media, dev, gaming, virt, CLI, tailscale, ...) come from the base image.
#
# Lines beginning with '#' and blank lines are ignored. Installed with
# `dnf install --skip-unavailable --skip-broken`.

# GNOME (GDM login/greeter; Sway is the default session — see scripts/configure.sh.
# gnome-shell is required by the GDM greeter even though Sway is the main WM)
gdm
evolution-data-server
gnome-backgrounds
gnome-console
gnome-control-center
gnome-disk-utility
gnome-initial-setup
gnome-menus
gnome-shell
gnome-session # session launcher GDM execs; Recommends-vulnerable under weak-deps-off
gnome-settings-daemon # display/power/media-keys glue; a missing g-s-d can black-screen the session
gnome-software
gnome-system-monitor
gnome-tweaks
gnome-keyring
# Fedora splits the PAM module into its own subpackage; without it logins log
# "gkr-pam: ... missing" and the login keyring is never unlocked (this also broke
# starting the Sway session via GDM). Required for GNOME/Silverblue-style keyring
# auto-unlock at login.
gnome-keyring-pam
mutter
nautilus
gvfs
gvfs-afc
gvfs-fuse
gvfs-goa
gvfs-gphoto2
gvfs-mtp
gvfs-nfs
gvfs-smb
# Portal backends. sway ships /usr/share/xdg-desktop-portal/sway-portals.conf
# (default=gtk, ScreenCast/Screenshot=wlr) which is already correct -- do NOT
# add an /etc override: pointing default at gnome breaks FileChooser, since the
# gnome backend dropped it (it delegates to Nautilus, dead in a sway session)
# and downloads in flatpak browsers silently fail.
xdg-desktop-portal-gtk
xdg-desktop-portal-gnome

# wlroots session helpers (launcher, notifications, clipboard, night light)
fuzzel
cliphist
gammastep
rofi-wayland
dunst
wl-mirror
seatd # seat management for the wlroots sessions

# Sway packages
kanshi
nwg-displays
nwg-look
sway
swayidle
swaylock
swaybg
waybar
wlr-randr
xdg-desktop-portal-wlr
grim
slurp
blueman
gammastep
gammastep-indicator

# Screen sharing: wlroots portal can't share single windows, only whole outputs.
# OBS + v4l2loopback virtual camera is the sway workaround — crop an output to a
# window in OBS, "Start Virtual Camera", then pick it as a webcam in the meeting
# app. OBS captures via the PipeWire screencast portal. akmod-v4l2loopback (base)
# builds the kernel module; it's loaded + configured via the overlay modprobe.d/
# modules-load.d drop-ins.
obs-studio
