#!/usr/bin/env bash
#
# fedora-update
#
# In-place update for an already-installed fedora-bootc system: rebuild the image
# locally on THIS machine and stage it as the bootc target for the NEXT boot
# (atomic, with rollback). Day-2 counterpart to fedora-usb (day-1 install).
#
# How it works:
#   1. `fedora-build <flavor>` rebuilds localhost/fedora-<flavor>:latest into
#      ROOT's podman storage — that's the store bootc reads from.
#   2. `bootc switch --transport containers-storage localhost/fedora-<flavor>:latest`
#      (falling back to `bootc upgrade` when the origin already points there)
#      re-reads the freshly built image from local storage and deploys it for the
#      next boot, then the staged deployment is finalized into the bootloader
#      immediately instead of at shutdown. Reboot (or pass --apply) to activate;
#      `bootc rollback` reverts to the previous deployment if something's wrong.
#
# Must run as root: both the rootful build (so the image lands where bootc looks)
# and bootc itself need privilege. Requires this repo (flavors/ + fedora-build),
# podman and bootc present on the machine — all shipped in the base image.
#
# Usage:
#   sudo ./fedora-update [--apply] [flavor]
#
# Options:
#   --apply     reboot immediately after staging
#   -h, --help  show this help
#
# Examples:
#   sudo ./fedora-update                 # rebuild gnome-sway, stage for next boot
#   sudo ./fedora-update --apply kde     # rebuild kde and reboot into it now
#
set -euo pipefail

self_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

die() { printf '\e[1;31m==> error:\e[0m %s\n' "$*" >&2; exit 1; }
info() { printf '\e[1;32m==>\e[0m\e[1m %s\e[0m\n' "$*"; }

apply=0
flavor=
while [[ $# -gt 0 ]]; do
	case "$1" in
		--apply)   apply=1; shift;;
		-h|--help) sed -n '2,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0;;
		-*)        die "unknown option: $1";;
		*)         flavor=$1; shift;;
	esac
done

flavor=${flavor:-gnome-sway}
image=localhost/fedora-${flavor}:latest

[[ $(id -u) -eq 0 ]] || die "must run as root: sudo ./fedora-update ${*:-$flavor}"
command -v bootc >/dev/null 2>&1 || die "bootc not found — fedora-update runs on an installed fedora-bootc system"
[[ -x $self_dir/fedora-build ]] || die "fedora-build not found next to fedora-update ($self_dir)"

# 1. Rebuild the image into ROOT's containers-storage (where bootc looks). The
#    build runs rootful here because we're already root; that's exactly what
#    makes the image visible to bootc below (no user->root copy needed).
info "building $image locally"
"$self_dir/fedora-build" "$flavor"

# 2. Stage it for the next boot straight from local storage. `switch` sets the
#    origin to the containers-storage ref (correct on the first update after
#    install), but it NO-OPS with "Image specification is unchanged" once the
#    origin already points there — it compares the spec, not the image. So every
#    later run must go through `upgrade`, which re-reads the rebuilt image.
#    ponytail: run switch, detect the no-op, fall through to upgrade.
info "staging $image for next boot (containers-storage)"
out=$(bootc switch --transport containers-storage "$image" 2>&1 | tee /dev/stderr)
if grep -qi 'specification is unchanged' <<<"$out"; then
	info "origin already set — pulling the rebuilt image with bootc upgrade"
	bootc upgrade
fi

# 3. Prove something was actually staged. Both switch and upgrade exit 0 when
#    they decide there is nothing to do, which silently boots the OLD image.
staged=$(bootc status --format=json 2>/dev/null | grep -o '"staged":[[:space:]]*null' || true)
if [[ -n $staged ]]; then
	die "nothing staged — bootc considers the running deployment up to date (check: bootc status)"
fi

# 4. Finalize NOW instead of at shutdown. ostree writes the new bootloader entry
#    only in ostree-finalize-staged.service's ExecStop; a hung or power-button
#    shutdown throws the update away and you boot the old image again.
#    ponytail: gives up ostree's "commit only on a clean shutdown" safety net —
#    the trade is deliberate, an unfinalized update is the thing biting here.
info "finalizing staged deployment now (surviving an unclean shutdown)"
systemctl stop ostree-finalize-staged.service || ostree admin finalize-staged

# 5. Release container-storage mounts the rebuild left behind; they are what
#    systemd-shutdown reports as "Failed to umount /run/shutdown/mounts/…".
podman unmount --all >/dev/null 2>&1 || true

if [[ $apply -eq 1 ]]; then
	info "rebooting"
	systemctl reboot
else
	cat <<EOF

Staged for next boot. Reboot to apply:
  sudo systemctl reboot

If the new image misbehaves, roll back to the previous deployment:
  sudo bootc rollback && sudo systemctl reboot
EOF
fi
