# s3.container — the Versity Gateway S3 server, as a podman Quadlet.
#
# Quadlet turns this file into a real systemd service (s3.service) at every boot,
# via /usr/lib/systemd/system-generators/podman-system-generator. Two consequences
# that matter on an image-mode host:
#
#   * `systemctl enable s3` DOES NOT WORK and neither does the .wants symlink
#     trick the rest of this repo uses to enable units offline — the generated
#     unit is transient, it lives in /run and there is nothing in /usr to link to.
#     The [Install] section below IS the enablement: the generator applies it
#     itself, exactly as `systemctl enable` would, on every boot. Do not "fix"
#     this by adding a symlink; it would dangle.
#   * Being in /usr/share/containers/systemd makes this the VENDOR copy — the
#     lowest-precedence search path. An operator can override the whole thing by
#     dropping a file of the same name in /etc/containers/systemd/.

[Unit]
Description=S3-compatible object storage (Versity Gateway)
Documentation=https://github.com/versity/versitygw/wiki
# Objects go on the NVMe or nowhere: without this the gateway would start before
# the mount and write into the empty mount point on the SD card.
Requires=var-lib-s3.mount
After=var-lib-s3.mount network-online.target
Wants=network-online.target

[Container]
# ponytail: pinned to a release tag, not :latest, so a reboot can never change
# what is serving your data. versitygw is Apache-2.0, actively released, and
# publishes an arm64 manifest.
Image=docker.io/versity/versitygw:v1.7.0

# The image entrypoint execs versitygw with whatever arguments it is given.
# Global flags MUST come before the `posix` backend subcommand. Port 9000 is not
# the versitygw default (:7070) — it is chosen because every S3 client and every
# piece of documentation on the internet assumes 9000.
Exec=--port :9000 --iam-dir /srv/iam posix --versioning-dir /srv/versions /srv/data

# ponytail: lowercase :z, not :Z. Both relabel for SELinux; :Z adds a
# per-container MCS category, which CHANGES on every start and would force podman
# to recursively relabel the entire object store — every file on the NVMe — each
# time the service restarts. :z gives the stable container_file_t:s0 label, so the
# relabel is a no-op after the first run. Nothing else shares this volume.
Volume=/var/lib/s3:/srv:z

PublishPort=9000:9000

# Generated on first start by ExecStartPre below; never baked into the image.
EnvironmentFile=/etc/s3/root.env

# One file descriptor per open object; the default limit runs out.
Ulimit=nofile=1048576:1048576

[Service]
ExecStartPre=/usr/libexec/s3-setup
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
