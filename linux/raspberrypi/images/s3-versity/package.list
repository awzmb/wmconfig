# Packages for the s3 flavor (single-node S3 server, objects on the NVMe).
#
# Deliberately NO S3 server package: versitygw is not in Fedora and upstream
# ships it as a container, which podman + Quadlet run from
# /usr/share/containers/systemd/. podman itself is already in the base image.

# --- Storage for the object volume ---------------------------------------
xfsprogs # REQUIRED: systemd-makefs shells out to mkfs.xfs to format the NVMe
util-linux # blkid guards the format step; lsblk to see what is actually there
attr # getfattr/setfattr: object metadata lives in user xattrs on the files

# --- NVMe / disk tooling -------------------------------------------------
nvme-cli # namespace/format/smart-log for the object drive
smartmontools # SMART health — the objects have no redundancy, watch the disk

# --- Diagnostics ---------------------------------------------------------
iotop
sysstat # iostat, mpstat, sar
