#!/bin/sh

podman run --rm -it \
  --user "$(id -u):$(id -g)" \
  --userns=keep-id \
  --volume "gcloud-config:/gcloud-config" \
  --env=CLOUDSDK_CONFIG=/gcloud-config \
  --volume "$HOME/.kube:/home/$(whoami)/.kube:ro" \
  --volume "$(pwd):/workspace:z" \
  --workdir "/workspace" \
  --env=KUBECONFIG=/home/$(whoami)/.kube/config \
  --env=TERM=$(echo ${TERM}) \
  localhost/flux:latest "$@"
